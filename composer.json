{
    "name": "probellm/probellm",
    "description": "A PHP testing framework for LLM-powered agents. Built on top of PHPUnit/Pest.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Avead556",
            "homepage": "https://github.com/Avead556"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0",
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "ProbeLLM\\": "src/"
        },
        "files": [
            "src/Pest/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ProbeLLM\\Tests\\": "tests/",
            "ProbeLLM\\Examples\\": "examples/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProbeLLM\\ProbeLLMServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit --testsuite=Unit",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-check": "./vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "./vendor/bin/php-cs-fixer fix --diff",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "suggest": {
        "pestphp/pest": "Required for Pest plugin support — global helpers and custom expectations (^2.0|^3.0)"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
